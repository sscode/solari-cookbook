{
  "name": "pr-flight-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "build": "vite build && tsup src/server/index.ts --format esm --out-dir dist-server --sourcemap --clean --external vite",
    "start": "node dist-server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.1",
    "@solarisdk/core": "^0.1.2",
    "@solarisdk/sdk": "^0.1.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "patchright-core": "1.59.3",
    "pino-http": "^10.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "rrweb-player": "^2.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "railway": "^3.11.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
